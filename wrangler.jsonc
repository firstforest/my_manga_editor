// Flutter Web (build/web) を Cloudflare Workers の静的アセットとして配信する。
// Worker スクリプトは持たない (assets のみ)。運用手順は docs/release.md 参照。
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // 本番: main への push で main.yml が `wrangler deploy` する (prod Firebase でビルド)
  "name": "my-manga-editor",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./build/web",
    // go_router のパスを直接開いたときも index.html を返す
    "not_found_handling": "single-page-application"
  },
  // 本番はカスタムドメインだけで配信する。DNS レコードと証明書はデプロイ時に Cloudflare が作る
  // (firstforest.jp のゾーンが同じ Cloudflare アカウントにある前提)
  "routes": [
    { "pattern": "komakusa.firstforest.jp", "custom_domain": true }
  ],
  // workers.dev でも開けるとログイン状態 (特に匿名ログイン) が origin ごとに分かれるため閉じる
  "workers_dev": false,
  // 本番 Worker にはバージョン URL を出さない (プレビューは下の別 Worker で行う)
  "preview_urls": false,
  "env": {
    // プレビュー用の Worker (my-manga-editor-preview)。dev Firebase でビルドしたものだけを載せる。
    // develop への push で `wrangler deploy --env preview` (固定 URL)、
    // PR では `wrangler versions upload --env preview --preview-alias pr-<番号>` (PR ごとの URL)
    "preview": {
      // routes はトップレベルから継承されるため、空にして本番ドメインを取らないようにする
      "routes": [],
      "workers_dev": true,
      "preview_urls": true
    }
  }
}
