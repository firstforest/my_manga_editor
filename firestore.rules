rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ユーザーごとのデータ（mangas / pages / deltas を含む配下すべて）。
    // 自分の UID 配下のみ読み書きできる。
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // バージョンゲートとアプリ内お知らせのグローバル設定
    // （FirebaseService.watchAppConfig が購読）。
    //
    // 誰でも読める。ログイン前に読めないと以下が成立しないため:
    //   - 更新ゲートは認証より先に評価される（lib/router.dart の redirect）。
    //     旧ビルドがキャッシュされてログイン自体が壊れている場合こそ更新案内を出したい
    //   - 事前告知はログイン画面の利用者にも届く必要がある
    // 中身は最小ビルド番号とお知らせ本文だけで、秘匿すべき情報は置かない。
    // 更新は管理者のみ（scripts/config.mjs が IAM 権限でルールをバイパスして書く）。
    match /config/app {
      allow read: if true;
      allow write: if false;
    }
  }
}
